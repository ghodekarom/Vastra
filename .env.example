# VASTRA E-Commerce Environment Configuration
# Toggle to "true" to switch from client mock adapter to Spring Boot 3 REST Monolith
NEXT_PUBLIC_USE_REMOTE_API="true"
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Razorpay Payment Gateway Configuration
# Key ID is public and passed to the frontend checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
# Key Secret is private and used only for server-side order creation & webhook/signature verification
RAZORPAY_KEY_SECRET="your_razorpay_secret_key_here"
